# Cấu hình dev (đọc bởi app/backend/app/infra/settings.py). Sao chép thành app/.env rồi sửa nếu cần.
ENV=dev
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable
DB_MODE=single
PUBLIC_BASE_URL=http://localhost:8080
COOKIE_SECURE=false

# IdP OIDC giả lập (app/backend/devidp) – người dùng mẫu: p1, p2, admin, outsider
OIDC_ISSUER=http://localhost:8090
OIDC_CLIENT_ID=aichat-dev
OIDC_CLIENT_SECRET=dev-secret-change-me

SESSION_SIGNING_KEY=dev-session-key-change-me
ACTOR_HASH_KEY=dev-actor-hash-key-change-me

BLOB_PROVIDER=local
EMBEDDING_PROVIDER=hashing

# LLM: extractive (chạy offline, không cần key) | anthropic (cần LLM_API_KEY)
LLM_PROVIDER=extractive
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
